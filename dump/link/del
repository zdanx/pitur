local holdingMinus = false
local holdingPlus = false

MinusButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        holdingMinus = true
        while holdingMinus do
            flySpeed = math.max(1, flySpeed - 1) -- Menggunakan 1 agar tidak terlalu cepat saat ditahan
            SpeedInput.Text = tostring(flySpeed)
            task.wait(0.05) -- Kecepatan pergantian angka saat ditahan
        end
    end
end)

MinusButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        holdingMinus = false
    end
end)

PlusButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        holdingPlus = true
        while holdingPlus do
            flySpeed = flySpeed + 1
            SpeedInput.Text = tostring(flySpeed)
            task.wait(0.05)
        end
    end
end)

PlusButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        holdingPlus = false
    end
end)

SpeedInput.FocusLost:Connect(function()
    local inputNum = tonumber(SpeedInput.Text)
    if inputNum then
        flySpeed = inputNum
    else
        SpeedInput.Text = tostring(flySpeed)
    end
end)

local function getRoot()
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function toggleFly()
    flying = not flying
    local root = getRoot()
    
    if flying and root then
        FlyToggle.Text = "Fly: ON"
        FlyToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlyToggle.BackgroundColor3 = Color3.fromRGB(5, 69, 223)
        
        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.Velocity = Vector3.new(0, 0, 0)
        flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        flyVelocity.Parent = root
        
        flyGyro = Instance.new("BodyGyro")
        flyGyro.P = 9e4
        flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyGyro.CFrame = root.CFrame
        flyGyro.Parent = root
        
        player.Character.Humanoid.PlatformStand = true
    else
        FlyToggle.Text = "Fly: OFF"
        FlyToggle.TextColor3 = Color3.fromRGB(180, 180, 180)
        FlyToggle.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        
        if flyVelocity then flyVelocity:Destroy() end
        if flyGyro then flyGyro:Destroy() end
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.PlatformStand = false
        end
    end
end

local function toggleFrame()
    frameOn = not frameOn
    if frameOn then
        FrameToggle.Text = "Frame: ON"
        FrameToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        FrameToggle.BackgroundColor3 = Color3.fromRGB(5, 69, 223)
    else
        FrameToggle.Text = "Frame: OFF"
        FrameToggle.TextColor3 = Color3.fromRGB(180, 180, 180)
        FrameToggle.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end

FlyToggle.MouseButton1Click:Connect(toggleFly)
FrameToggle.MouseButton1Click:Connect(toggleFrame)

local ctrl = {f = 0, b = 0, l = 0, r = 0}

-- Mengambil modul kontrol bawaan Roblox (mendukung PC, Mobile, dan Console)
local PlayerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local ControlModule = PlayerModule:GetControls()

RunService.RenderStepped:Connect(function()
    if flying and getRoot() then
        local root = getRoot()
        local camCFrame = camera.CFrame
        
        -- Membaca arah dari joystick mobile atau tombol WASD
        local moveVector = ControlModule:GetMoveVector()
        local moveDir = Vector3.new(0, 0, 0)
        
        -- Z negatif adalah arah depan joystick, X adalah arah samping
        if frameOn then
            flyGyro.CFrame = camCFrame
            moveDir = camCFrame.LookVector * (-moveVector.Z) + camCFrame.RightVector * (moveVector.X)
        else
            flyGyro.CFrame = CFrame.new(root.Position, root.Position + camCFrame.lookVector * Vector3.new(1, 0, 1))
            moveDir = camCFrame.LookVector * (-moveVector.Z) + camCFrame.RightVector * (moveVector.X)
        end
        
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
        end
        
        flyVelocity.Velocity = moveDir * flySpeed
    end
end)
